# COPY THIS FILE AND RENAME IT TO .env TO MAKE CHANGES

# turn on to see more debug logging
DEBUG=False

# directory for run recordings and scorecards (git-ignored)
RECORDINGS_DIR=recordings

# directory of pre-written replies for --agent reply ({spec}.txt)
ANSWERS_DIR=answers

# --agent claude: the Anthropic API solver (the prompt + the two calculators, nothing else)
ANTHROPIC_API_KEY=
SOLVER_MODEL=claude-opus-5
SOLVER_EFFORT=high
SOLVER_MAX_TOKENS=64000
